---
// 动画作品页 —— 套 BareGridLayout：共用 Firefly 导航/页脚，内容全出血
import BareGridLayout from "@/layouts/BareGridLayout.astro";
import { getCollection } from "astro:content";

// 作品：来自 projects 集合（按 order 排）
const allProjects = (
	await getCollection("projects", ({ data }) => !data.draft)
).sort(
	(a, b) =>
		(b.data.order ?? 0) - (a.data.order ?? 0) ||
		+b.data.published - +a.data.published,
);
const works = allProjects.slice(0, 5);

// 文章：只取带「动画」标签的（与主页共用同一批数据）
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const animPosts = allPosts
	.filter((p) => (p.data.tags ?? []).includes("动画"))
	.sort((a, b) => +b.data.published - +a.data.published)
	.slice(0, 5);

const pad2 = (n: number) => String(n).padStart(2, "0");
const fmtDate = (d: Date) =>
	`${d.getFullYear()}.${pad2(d.getMonth() + 1)}.${pad2(d.getDate())}`;
---

<BareGridLayout title="Animation">

<div class="anim-page">


<header class="hero">
  <div class="bg"></div>
  <div class="grain"></div>
  <div class="wrap in" id="heroIn">
    <div class="eyebrow"><i></i>Latest · 2026</div>
    <h1 class="serif">Teaser<br><em>二〇二六</em></h1>
    <div class="cta">
      <a class="btn" href={works[0] ? `/projects/${works[0].id}/` : "#works"}><span class="play"></span>Watch now</a>
      <a class="btn ghost" href="/projects/">看全部作品 →</a>
    </div>
  </div>
  <div class="cue"><span></span>scroll</div>
</header>

<div class="wrap">

  <section id="works">
    <div class="head reveal">
      <h2>Works</h2>
      <span class="n">{pad2(works.length)} / {pad2(allProjects.length)}</span>
      <a href="/projects/">All works →</a>
    </div>

    {works.length > 0 ? (
      <div class="bento">
        {works.map((w, i) => {
          const big = i < 2;
          const cls = big ? (i === 0 ? "b1" : "b2") : `s s${i}`;
          const artStyle = w.data.image
            ? `background-image:url(${w.data.image});background-size:cover;background-position:center;`
            : "";
          return (
            <a class:list={["card", cls, "reveal"]} href={`/projects/${w.id}/`}>
              <div class="art" style={artStyle} />
              <div class="cap">
                <div class="k">
                  {w.data.status || "Project"} · {w.data.published.getFullYear()}
                </div>
                <h3>{w.data.title}</h3>
                <p class="desc">{w.data.description}</p>
              </div>
              <span class="go">View →</span>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="empty reveal">还没有作品，去 <a href="/projects/">Projects</a> 里加。</p>
    )}
  </section>

  <section id="writing">
    <div class="head reveal">
      <h2>Writing · 动画相关</h2>
      <span class="n">{pad2(animPosts.length)}</span>
      <a href="/archive/?tag=%E5%8A%A8%E7%94%BB">All posts →</a>
    </div>

    {animPosts.length > 0 ? (
      animPosts.map((p) => (
        <a class="post reveal" href={`/posts/${p.id}/`}>
          <div class="d">{fmtDate(p.data.published)}</div>
          <div>
            <h4>{p.data.title}</h4>
            <p>{p.data.description}</p>
          </div>
          <span class="tag">{p.data.category || p.data.tags?.[0] || ""}</span>
        </a>
      ))
    ) : (
      <p class="empty reveal">
        还没有动画相关的文章。给文章加上 <code>动画</code> 标签就会出现。
      </p>
    )}
  </section>

  <section id="about">
    <div class="about" style="grid-template-columns:1fr">
      <div class="reveal">
        <p>计算机专业在读。角色在 Toon Boom Harmony 里绑定和动画，环境在 Blender 里渲染，两边靠自写的工具同步。</p>
        
      </div>
    </div>
  </section>

  </div>

<script>
// 导航变色
addEventListener('scroll', () => {
  const h = document.getElementById('heroIn');
  if (h && scrollY < innerHeight) h.style.transform = 'translateY(' + (scrollY * 0.18) + 'px)';
}, {passive:true});// 滚动出现
const io = new IntersectionObserver(es=>{
  es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
},{threshold:.12});
document.querySelectorAll('.reveal').forEach((el,i)=>{
  (el as HTMLElement).style.transitionDelay = (i % 5) * 60 + 'ms';
  io.observe(el);
});
</script>

</div>

</BareGridLayout>

<style is:global>

  :root{
    --bg:#0d0d0f; --bg2:#16161a; --fg:#f2ebe3; --fg2:#a89a8a; --fg3:#6b6157;
    --line:#1a2028;
    --c1:#7c6cf0; --c2:#b08a4e; --c3:#4fb6a8; --c4:#e0699b; --c5:#b08a4e;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--fg);
    font-family:-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;
    font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1180px;margin:0 auto;padding:0 32px}
  .serif{font-family:"Georgia","Songti SC",serif}
  .mono{font-family:Consolas,monospace;letter-spacing:.06em}

  /* ---------------- HERO ---------------- */
  .hero{position:relative;height:100vh;min-height:600px;display:flex;
    align-items:flex-end;overflow:hidden}
  .hero .bg{position:absolute;inset:0;
    background:
      radial-gradient(1200px 700px at 72% 8%, #2c3f7a 0%, transparent 58%),
      radial-gradient(900px 600px at 12% 88%, #7a2c46 0%, transparent 52%),
      radial-gradient(700px 500px at 88% 78%, #1d5c56 0%, transparent 50%),
      linear-gradient(165deg,#080a0e,#12161f 55%,#080a0e);
  }
  .hero .bg::after{content:"";position:absolute;inset:0;
    background:linear-gradient(to top,rgba(6,8,11,.95) 0%,rgba(6,8,11,.4) 46%,transparent 78%)}
  .hero .grain{position:absolute;inset:0;opacity:.22;pointer-events:none;
    background-image:radial-gradient(rgba(255,255,255,.5) 1px,transparent 1px);
    background-size:3px 3px;mix-blend-mode:overlay}
  .hero .in{position:relative;z-index:2;padding-bottom:96px;width:100%;
    will-change:transform}
  .eyebrow{display:flex;align-items:center;gap:12px;font-size:11px;letter-spacing:.26em;
    text-transform:uppercase;color:#ffffff8c;margin-bottom:18px}
  .eyebrow i{display:block;width:36px;height:1px;background:var(--c2)}
  .hero h1{font-family:"Georgia","Songti SC",serif;
    font-size:clamp(46px,8.4vw,104px);line-height:.96;margin:0 0 20px;
    letter-spacing:-.03em;font-weight:600}
  .hero h1 em{font-style:normal;
    background:linear-gradient(92deg,var(--c2),var(--c4) 60%,var(--c1));
    -webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p{margin:0 0 30px;color:#ffffffb3;font-size:16.5px;max-width:520px}
  .cta{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:10px;padding:13px 26px;
    border:1px solid #ffffff40;border-radius:2px;font-size:12px;letter-spacing:.18em;
    text-transform:uppercase;transition:.22s}
  .btn:hover{background:#fff;color:#0d0d0f;border-color:#fff}
  .btn.ghost{border-color:transparent;color:#ffffff99}
  .btn.ghost:hover{background:transparent;color:#fff;border-color:transparent}
  .play{width:0;height:0;border-left:7px solid currentColor;
    border-top:4.5px solid transparent;border-bottom:4.5px solid transparent}
  .cue{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);z-index:3;
    font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#ffffff66;
    display:flex;flex-direction:column;align-items:center;gap:8px}
  .cue span{display:block;width:1px;height:34px;
    background:linear-gradient(to bottom,#ffffff66,transparent);animation:drop 1.8s infinite}
  @keyframes drop{0%{transform:scaleY(.2);transform-origin:top;opacity:.3}
    60%{transform:scaleY(1);opacity:1}100%{transform:scaleY(.2);transform-origin:bottom;opacity:.3}}

  /* ---------------- 区块标题 ---------------- */
  section{padding:104px 0}
  .head{display:flex;align-items:flex-end;justify-content:space-between;
    margin-bottom:38px;padding-bottom:16px;border-bottom:1px solid var(--line)}
  .head h2{margin:0;font-size:12px;letter-spacing:.26em;text-transform:uppercase;
    color:var(--fg2);font-weight:600}
  .head .n{font-family:Consolas,monospace;font-size:11px;color:var(--fg3)}
  .head a{font-size:12px;color:var(--c2);letter-spacing:.08em;position:relative}
  .head a::after{content:"";position:absolute;left:0;right:0;bottom:-3px;height:1px;
    background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .25s}
  .head a:hover::after{transform:scaleX(1)}
.empty{margin:0;padding:26px 0;font-size:13px;color:var(--fg3);letter-spacing:.02em}
.empty a{color:var(--c2)}
.empty code{font-family:Consolas,monospace;font-size:12px;color:var(--fg2);background:#ffffff0f;padding:1px 5px;border-radius:2px}

  /* ---------------- 便当网格 ---------------- */
  .bento{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:158px;gap:14px}
  .card{position:relative;overflow:hidden;border-radius:4px;display:block;
    transition:transform .4s cubic-bezier(.2,.8,.2,1)}
  .card:hover{transform:translateY(-4px)}
  .card .art{position:absolute;inset:0;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
  .card:hover .art{transform:scale(1.07)}
  .card .art::after{content:"";position:absolute;inset:0;
    background:linear-gradient(to top,rgba(5,7,10,.9) 0%,rgba(5,7,10,.25) 42%,transparent 72%)}
  .card .cap{position:absolute;left:0;right:0;bottom:0;padding:20px 22px;z-index:2}
  .card .k{font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#ffffff8c;
    margin-bottom:6px;transform:translateY(0);transition:.3s}
  .card h3{margin:0;font-family:Georgia,"Songti SC",serif;font-size:21px;font-weight:600;
    letter-spacing:-.01em;color:#fff}
  .card .desc{margin:0;font-size:13px;color:#ffffffa8;max-height:0;opacity:0;
    overflow:hidden;transition:max-height .35s,opacity .3s,margin .3s}
  .card:hover .desc{max-height:60px;opacity:1;margin-top:8px}
  .card .go{position:absolute;right:20px;bottom:20px;font-size:11px;letter-spacing:.16em;
    color:#fff;opacity:0;transform:translateX(-6px);transition:.3s}
  .card:hover .go{opacity:1;transform:none}

  .b1{grid-column:span 3;grid-row:span 2}
  .b2{grid-column:span 3;grid-row:span 2}
  .s{grid-column:span 2}
  .b1 h3,.b2 h3{font-size:27px}
  .b1 .art{background:linear-gradient(140deg,#241a4a,#4c3aa8 55%,#7c6cf0)}
  .b2 .art{background:linear-gradient(140deg,#3a1d12,#a8451f 55%,#b08a4e)}
  .s1 .art{background:linear-gradient(140deg,#0e2b33,#1f6f68 55%,#4fb6a8)}
  .s2 .art{background:linear-gradient(140deg,#331327,#8e2f5c 55%,#e0699b)}
  .s3 .art{background:linear-gradient(140deg,#2e2410,#8a6516 55%,#b08a4e)}
  @media(max-width:860px){
    .bento{grid-template-columns:repeat(2,1fr);grid-auto-rows:170px}
    .b1,.b2{grid-column:span 2;grid-row:span 1}
    .s{grid-column:span 1}
  }

  /* ---------------- 文章（两栏） ---------------- */
  .post{display:grid;grid-template-columns:120px 1fr 110px;gap:28px;
    padding:26px 0;border-bottom:1px solid var(--line);align-items:baseline;
    position:relative;transition:padding-left .3s}
  .post::before{content:"";position:absolute;left:0;top:26px;bottom:26px;width:2px;
    background:var(--c2);transform:scaleY(0);transform-origin:top;transition:transform .3s}
  .post:hover{padding-left:18px}
  .post:hover::before{transform:scaleY(1)}
  .post .d{font-family:Consolas,monospace;font-size:12px;color:var(--fg3)}
  .post h4{margin:0 0 5px;font-family:Georgia,"Songti SC",serif;font-size:20px;
    font-weight:600;letter-spacing:-.01em;transition:color .2s}
  .post:hover h4{color:var(--c2)}
  .post p{margin:0;color:var(--fg2);font-size:14px}
  .post .tag{justify-self:end;font-size:11px;color:var(--fg3);
    border:1px solid var(--line);padding:2px 9px;border-radius:2px}
  @media(max-width:720px){
    .post{grid-template-columns:1fr;gap:6px}
    .post .tag{justify-self:start}
  }

  /* ---------------- 关于 / 页脚 ---------------- */
  .about{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
  .about p{margin:0 0 14px;color:var(--fg2);font-size:15.5px}
  .about p:last-child{margin:0}
  .about .big{font-family:Georgia,"Songti SC",serif;font-size:26px;line-height:1.5;
    color:var(--fg);letter-spacing:-.01em;margin:0}
  @media(max-width:760px){.about{grid-template-columns:1fr;gap:28px}}

  footer{border-top:1px solid var(--line);padding:34px 0 64px;
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;
    font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fg3)}
  footer .soc{display:flex;gap:22px}
  footer a{transition:color .2s}
  footer a:hover{color:var(--c2)}

  /* ---------------- 滚动出现 ---------------- */
  .reveal{opacity:0;transform:translateY(16px);
    transition:opacity .7s cubic-bezier(.2,.8,.2,1),transform .7s cubic-bezier(.2,.8,.2,1)}
  .reveal.in{opacity:1;transform:none}

</style>