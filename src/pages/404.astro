---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

const latest = (await getSortedPosts()).slice(0, 3);

const pad2 = (n: number) => String(n).padStart(2, "0");
const fmt = (d: Date) =>
	`${d.getFullYear()}.${pad2(d.getMonth() + 1)}.${pad2(d.getDate())}`;
---

<MainGridLayout title="404" description="页面不存在">
  <div class="nf">
    <div class="nf-k">Error · Not Found</div>
    <div class="nf-code">404</div>
    <h1 class="nf-title">这里什么都没有</h1>
    <p class="nf-desc">链接可能过期了，或者从来就不存在。</p>

    <div class="nf-actions">
      <a class="nf-btn primary" href={url("/")}>回首页</a>
      <a class="nf-btn" href={url("/search/")}>搜一篇</a>
      <a class="nf-btn" href={url("/archive/")}>看归档</a>
    </div>

    {
      latest.length > 0 && (
        <div class="nf-latest">
          <div class="nf-sub">最近写的</div>
          {latest.map((p) => (
            <a class="nf-row" href={getPostUrlBySlug(p.id)}>
              <time>{fmt(p.data.published)}</time>
              <span class="t">{p.data.title}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</MainGridLayout>

<style>
  .nf {
    padding: 72px 8px 40px;
  }
  .nf-k {
    font-family: "Source Code Pro", ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--content-meta);
    margin-bottom: 10px;
  }
  .nf-code {
    font-family: "Parisienne", cursive;
    font-size: clamp(72px, 15vw, 168px);
    line-height: 0.9;
    color: rgba(231, 208, 186, 0.16);
    margin: 0 0 8px -4px;
    user-select: none;
  }
  .nf-title {
    font-family: "Abel", sans-serif;
    font-weight: 400;
    font-size: clamp(24px, 3.4vw, 34px);
    letter-spacing: 0.01em;
    margin: 0 0 10px;
    color: var(--deep-text);
  }
  .nf-desc {
    margin: 0 0 26px;
    font-size: 14px;
    color: var(--content-meta);
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .nf-btn {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 20px;
    border: 1px solid var(--line-divider);
    font-family: "Source Code Pro", ui-monospace, monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--deep-text);
    transition: border-color 0.2s, color 0.2s, background-color 0.2s;
  }
  .nf-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .nf-btn.primary {
    background: var(--primary);
    border-color: var(--primary);
    color: #0d0d0f;
  }
  .nf-btn.primary:hover {
    opacity: 0.88;
    color: #0d0d0f;
  }

  .nf-latest {
    margin-top: 56px;
    max-width: 620px;
  }
  .nf-sub {
    font-family: "Source Code Pro", ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--content-meta);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-divider);
  }
  .nf-row {
    display: flex;
    gap: 18px;
    align-items: baseline;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-divider);
    text-decoration: none;
  }
  .nf-row time {
    font-family: "Source Code Pro", ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--content-meta);
    flex: none;
  }
  .nf-row .t {
    font-family: "Abel", sans-serif;
    font-size: 15px;
    color: var(--deep-text);
    transition: color 0.2s;
  }
  .nf-row:hover .t {
    color: var(--primary);
  }

  @media (max-width: 640px) {
    .nf {
      padding-top: 48px;
    }
    .nf-row {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
